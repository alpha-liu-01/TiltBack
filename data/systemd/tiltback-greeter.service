[Unit]
Description=TiltBack greeter persist (picture + residual)
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service plasmalogin.service gdm.service gdm3.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/tiltback/install-greeter.sh
RemainAfterExit=yes

[Install]
WantedBy=display-manager.service
