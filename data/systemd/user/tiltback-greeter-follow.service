[Unit]
Description=TiltBack greeter residual restamp
After=plasma-login-kwin_wayland.service
PartOf=plasma-login-wayland.target
ConditionPathExists=%h/.config/tiltback/home.json

[Service]
Type=simple
ExecStart=/usr/bin/tiltback --follow
Restart=on-failure
RestartSec=1

[Install]
WantedBy=plasma-login-wayland.target
