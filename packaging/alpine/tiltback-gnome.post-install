#!/bin/sh
# Enable the system path unit so follow can rebind HID without a password.
if [ -d /run/systemd/system ]; then
	systemd-tmpfiles --create /usr/lib/tmpfiles.d/tiltback.conf 2>/dev/null || true
	systemctl daemon-reload 2>/dev/null || true
	systemctl preset tiltback-rebind.path 2>/dev/null || true
	systemctl enable --now tiltback-rebind.path 2>/dev/null || true
fi
exit 0
