#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
	if [ -d /run/systemd/system ]; then
		deb-systemd-invoke stop tiltback-rebind.path >/dev/null 2>&1 || true
		deb-systemd-helper disable tiltback-rebind.path >/dev/null 2>&1 || true
		systemctl daemon-reload >/dev/null 2>&1 || true
	fi
fi
exit 0
