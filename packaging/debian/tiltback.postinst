#!/bin/sh
set -e
# Leftover clinic desktop under ~/.local wins over /usr/share and
# launches ~/.local/bin/tiltback, which pkexecs the user rebind script.
if [ "$1" = configure ]; then
	for f in /home/*/.local/share/applications/org.tiltback.TiltBack.desktop; do
		[ -f "$f" ] || continue
		if grep -q '\.local/bin/tiltback' "$f"; then
			rm -f "$f"
		fi
	done
	for b in /home/*/.local/bin/tiltback; do
		[ -x "$b" ] || continue
		mv "$b" "$b.pre-pkg" 2>/dev/null || true
	done
	for u in /home/*/.config/systemd/user/tiltback-follow.service; do
		[ -f "$u" ] || continue
		sed -i 's|/home/[^/]*/.local/bin/tiltback|/usr/bin/tiltback|g' "$u" 2>/dev/null || true
	done
	if [ -d /run/systemd/system ]; then
		systemd-tmpfiles --create /usr/lib/tmpfiles.d/tiltback.conf 2>/dev/null || true
		systemctl daemon-reload >/dev/null 2>&1 || true
		deb-systemd-helper enable tiltback-greeter.service >/dev/null || true
		deb-systemd-helper enable tiltback-greeter.path >/dev/null || true
		deb-systemd-helper enable tiltback-accel.path >/dev/null || true
		deb-systemd-invoke start tiltback-greeter.path >/dev/null || true
		deb-systemd-invoke start tiltback-greeter.service >/dev/null || true
		deb-systemd-invoke start tiltback-accel.path >/dev/null || true
	fi
fi
exit 0
