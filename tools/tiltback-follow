#!/usr/bin/env python3
"""Follow-output residual for the Galaxy Book W620 on Plasma 6 / KWin.

The W620's picture-vs-input gap is a constant 180° in device space at
every Plasma pose. KWin InputDevice orientation 8 (InvertedLandscape)
cancels it for left, right, none, and inverted.

KWin clears that orientation back to 0 on every output transform change
(including the 15s Display Configuration revert). This helper watches
live KScreen T and re-stamps orientation 8. It never changes T.
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import subprocess
import sys
import time

KWIN = "org.kde.KWin"
IFACE = "org.kde.KWin.InputDevice"
PREFIX = "/org/kde/KWin/InputDevice"

# KScreen Output::Rotation bit flags
ROT_NONE = 1
ROT_LEFT = 2
ROT_INVERTED = 4
ROT_RIGHT = 8

# Qt::ScreenOrientation as exposed on orientationDBus
R_INVERTED_LANDSCAPE = 8

TARGET_NAMES = {
    "WCOM0028:00 2D1F:000C Stylus",
    "STMD1234:00 06CB:1058",
}


def residual_for(_rotation: int) -> int:
    return R_INVERTED_LANDSCAPE


def run(cmd: list[str], timeout: float = 8.0) -> subprocess.CompletedProcess[str]:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
    return subprocess.run(cmd, check=False, capture_output=True, text=True, timeout=timeout, env=env)


def current_rotation() -> int | None:
    proc = run(["kscreen-doctor", "-j"])
    if proc.returncode != 0:
        logging.warning("kscreen-doctor failed: %s", proc.stderr.strip())
        return None
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        logging.warning("kscreen-doctor json: %s", exc)
        return None
    for output in data.get("outputs", []):
        if output.get("name") == "eDP-1" and output.get("enabled"):
            return int(output["rotation"])
    if data.get("outputs"):
        return int(data["outputs"][0]["rotation"])
    return None


def rotation_name(rotation: int) -> str:
    names = []
    if rotation & ROT_NONE and not (rotation & (ROT_LEFT | ROT_INVERTED | ROT_RIGHT)):
        return "none"
    if rotation == ROT_NONE:
        return "none"
    if rotation & ROT_LEFT:
        names.append("left")
    if rotation & ROT_RIGHT:
        names.append("right")
    if rotation & ROT_INVERTED:
        names.append("inverted")
    if rotation & ROT_NONE and names:
        names.append("none-bit")
    return "+".join(names) if names else f"raw:{rotation}"


def list_target_paths() -> list[tuple[str, str]]:
    proc = run(["busctl", "--user", "tree", "--list", KWIN])
    found: list[tuple[str, str]] = []
    for line in proc.stdout.splitlines():
        path = line.strip()
        if not path.startswith(PREFIX + "/"):
            continue
        name_proc = run(
            ["busctl", "--user", "get-property", KWIN, path, IFACE, "name"]
        )
        if name_proc.returncode != 0:
            continue
        # s "device name"
        raw = name_proc.stdout.strip()
        name = raw.split('"', 1)[-1].rsplit('"', 1)[0] if '"' in raw else raw
        if name in TARGET_NAMES:
            found.append((path, name))
    return found


def get_orientation(path: str) -> int | None:
    proc = run(["busctl", "--user", "get-property", KWIN, path, IFACE, "orientationDBus"])
    if proc.returncode != 0:
        return None
    parts = proc.stdout.split()
    # i 8
    try:
        return int(parts[1])
    except (IndexError, ValueError):
        return None


def set_orientation(path: str, value: int) -> bool:
    proc = run(
        [
            "busctl",
            "--user",
            "set-property",
            KWIN,
            path,
            IFACE,
            "orientationDBus",
            "i",
            str(value),
        ]
    )
    if proc.returncode != 0:
        logging.error("set %s orientationDBus=%s: %s", path, value, proc.stderr.strip())
        return False
    return True


def apply(reason: str = "") -> tuple[int | None, int | None]:
    rotation = current_rotation()
    if rotation is None:
        return None, None
    wanted = residual_for(rotation)
    targets = list_target_paths()
    if not targets:
        logging.error("no target input devices on KWin D-Bus")
        return rotation, wanted
    changed = False
    for path, name in targets:
        have = get_orientation(path)
        if have == wanted:
            continue
        if set_orientation(path, wanted):
            logging.info(
                "set %s orientation %s -> %s (output %s=%s%s)",
                name,
                have,
                wanted,
                rotation_name(rotation),
                rotation,
                f", {reason}" if reason else "",
            )
            changed = True
    if not changed:
        logging.debug(
            "already aligned: output %s=%s residual=%s",
            rotation_name(rotation),
            rotation,
            wanted,
        )
    return rotation, wanted


def daemon(interval: float) -> int:
    logging.info("follow-output started, poll %.2fs", interval)
    apply("startup")
    last = current_rotation()
    last_verify = time.monotonic()
    while True:
        time.sleep(interval)
        now = current_rotation()
        if now is None:
            continue
        if now != last:
            logging.info(
                "output transform %s -> %s",
                rotation_name(last) if last is not None else "?",
                rotation_name(now),
            )
            apply("kscreen change")
            last = now
            last_verify = time.monotonic()
        elif time.monotonic() - last_verify >= 2.0:
            # Plasma's 15s "keep this?" revert can drop the residual.
            apply("verify")
            last_verify = time.monotonic()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="apply R(T) once and exit")
    parser.add_argument("--interval", type=float, default=0.4, help="poll seconds")
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args()

    log_dir = os.path.expanduser("~/.local/share/tiltback")
    os.makedirs(log_dir, exist_ok=True)
    handlers: list[logging.Handler] = [logging.StreamHandler(sys.stderr)]
    try:
        handlers.append(logging.FileHandler(os.path.join(log_dir, "follow.log")))
    except OSError:
        pass
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=handlers,
    )

    if args.once:
        rotation, wanted = apply("once")
        if rotation is None:
            return 1
        print(f"output={rotation_name(rotation)} ({rotation}) residual={wanted}")
        return 0
    return daemon(args.interval)


if __name__ == "__main__":
    sys.exit(main())
