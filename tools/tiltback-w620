#!/usr/bin/env python3
"""Entire Galaxy Book W620 session fix. Safe to re-run after a reboot.

Applies the measured home pose, then keeps the 180° residual on the
built-in digitizers when Plasma changes display orientation.

    python3 tools/tiltback-w620           # install + apply home + start follow
    python3 tools/tiltback-w620 --status  # four layers + cover touchpad
    python3 tools/tiltback-w620 --follow  # daemon (systemd only)

Never writes KWin properties on the type-cover HID (04e8:a00a), the
Wacom companion mouse node, or any touchpad.

Follow does not poll kscreen-doctor. It restamps from KWin D-Bus
signals, a directory watch on kwinoutputconfig.json (inode replace),
and a 0.4s in-process Get of the two digitizer orientations. One
systemd --user unit; no Plasma autostart copy.
"""

from __future__ import annotations

import argparse
import json
import logging
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

KWIN = "org.kde.KWin"
IFACE = "org.kde.KWin.InputDevice"
MGR_IFACE = "org.kde.KWin.InputDeviceManager"
PROPS_IFACE = "org.freedesktop.DBus.Properties"
PREFIX = "/org/kde/KWin/InputDevice"

ROT_NONE = 1
ROT_LEFT = 2
ROT_INVERTED = 4
ROT_RIGHT = 8
R_HOME = 8  # Qt::InvertedLandscapeOrientation

HOME_KSCREEN = "left"
TARGET_NAMES = {
    "WCOM0028:00 2D1F:000C Stylus",
    "STMD1234:00 06CB:1058",
}
DENY_NAME_SUBSTR = (
    "04e8:a00a",
    "Touchpad",
    "WCOM0028:00 2D1F:000C Mouse",
)

SERVICE_NAME = "tiltback-w620.service"
OLD_SERVICE = "tiltback-follow.service"
OLD_DESKTOPS = ("tiltback-w620.desktop", "tiltback-follow.desktop")


def session_env() -> dict[str, str]:
    env = os.environ.copy()
    uid = os.getuid()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={env['XDG_RUNTIME_DIR']}/bus")
    return env


def run(cmd: list[str], timeout: float = 12.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd, check=False, capture_output=True, text=True, timeout=timeout, env=session_env()
    )


def rotation_name(rotation: int) -> str:
    if rotation == ROT_NONE:
        return "none"
    names = []
    if rotation & ROT_LEFT:
        names.append("left")
    if rotation & ROT_RIGHT:
        names.append("right")
    if rotation & ROT_INVERTED:
        names.append("inverted")
    return "+".join(names) if names else f"raw:{rotation}"


def current_rotation() -> int | None:
    proc = run(["kscreen-doctor", "-j"])
    if proc.returncode != 0:
        logging.warning("kscreen-doctor failed: %s", proc.stderr.strip())
        return None
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        logging.warning("kscreen-doctor json: %s", exc)
        return None
    for output in data.get("outputs", []):
        if output.get("name") == "eDP-1" and output.get("enabled"):
            return int(output["rotation"])
    if data.get("outputs"):
        return int(data["outputs"][0]["rotation"])
    return None


def is_denied_name(name: str, touchpad: bool | None = None) -> bool:
    if touchpad is True:
        return True
    return any(token in name for token in DENY_NAME_SUBSTR)


def is_target_name(name: str, touchpad: bool | None = None) -> bool:
    return name in TARGET_NAMES and not is_denied_name(name, touchpad)


class KWinBus:
    """In-process KWin InputDevice access. No busctl / kscreen-doctor."""

    def __init__(self) -> None:
        import dbus

        self._dbus = dbus
        self.bus = dbus.SessionBus()
        self._targets: list[tuple[str, str]] = []

    def _mgr_props(self):
        obj = self.bus.get_object(KWIN, PREFIX)
        return self._dbus.Interface(obj, PROPS_IFACE)

    def _dev_props(self, path: str):
        obj = self.bus.get_object(KWIN, path)
        return self._dbus.Interface(obj, PROPS_IFACE)

    def refresh_targets(self) -> list[tuple[str, str]]:
        sysnames = list(self._mgr_props().Get(MGR_IFACE, "devicesSysNames"))
        found: list[tuple[str, str]] = []
        for sysname in sysnames:
            path = f"{PREFIX}/{sysname}"
            try:
                name = str(self._dev_props(path).Get(IFACE, "name"))
            except self._dbus.exceptions.DBusException:
                continue
            if is_target_name(name):
                found.append((path, name))
        self._targets = found
        if not found:
            logging.error("no target digitizers on KWin D-Bus")
        return found

    def targets(self) -> list[tuple[str, str]]:
        if not self._targets:
            self.refresh_targets()
        return list(self._targets)

    def get_orientation(self, path: str) -> int | None:
        try:
            return int(self._dev_props(path).Get(IFACE, "orientationDBus"))
        except (self._dbus.exceptions.DBusException, ValueError, TypeError):
            return None

    def set_orientation(self, path: str, value: int) -> bool:
        try:
            self._dev_props(path).Set(IFACE, "orientationDBus", self._dbus.Int32(value))
            return True
        except self._dbus.exceptions.DBusException as exc:
            logging.error("set %s orientationDBus=%s: %s", path, value, exc)
            return False

    def list_devices(self) -> list[dict[str, object]]:
        sysnames = list(self._mgr_props().Get(MGR_IFACE, "devicesSysNames"))
        devices = []
        for sysname in sysnames:
            path = f"{PREFIX}/{sysname}"
            try:
                allp = {
                    str(k): v
                    for k, v in self._dev_props(path).GetAll(IFACE).items()
                }
            except self._dbus.exceptions.DBusException:
                continue
            devices.append(
                {
                    "path": path,
                    "name": str(allp.get("name") or ""),
                    "enabled": bool(allp.get("enabled")),
                    "touch": bool(allp.get("touch")),
                    "touchpad": bool(allp.get("touchpad")),
                    "tabletTool": bool(allp.get("tabletTool")),
                    "orientation": int(allp.get("orientationDBus") or 0),
                }
            )
        return devices


def apply_residual(kwin: KWinBus, reason: str = "") -> int:
    changed = 0
    for path, name in kwin.targets():
        have = kwin.get_orientation(path)
        if have == R_HOME:
            continue
        if kwin.set_orientation(path, R_HOME):
            logging.info(
                "set %s orientation %s -> %s%s",
                name,
                have,
                R_HOME,
                f" ({reason})" if reason else "",
            )
            changed += 1
    return changed


def apply_home_display() -> bool:
    proc = run(["kscreen-doctor", f"output.eDP-1.rotation.{HOME_KSCREEN}"])
    if proc.returncode != 0:
        logging.error("kscreen-doctor: %s", proc.stderr.strip() or proc.stdout.strip())
        return False
    logging.info("set eDP-1 rotation %s", HOME_KSCREEN)
    return True


def print_status() -> int:
    rotation = current_rotation()
    print(f"output eDP-1  T={rotation_name(rotation) if rotation is not None else '?'} ({rotation})")
    print(f"home display  {HOME_KSCREEN}")
    print(f"home residual {R_HOME}  (InvertedLandscape, device-space 180°)")
    print()
    print(f"{'device':<42} {'kind':<10} {'en':<5} {'R':<4} note")
    kwin = KWinBus()
    for dev in kwin.list_devices():
        kind = (
            "touch"
            if dev["touch"]
            else "stylus"
            if dev["tabletTool"]
            else "touchpad"
            if dev["touchpad"]
            else "other"
        )
        name = str(dev["name"])
        if is_target_name(name, bool(dev["touchpad"])):
            note = "TARGET"
        elif is_denied_name(name, bool(dev["touchpad"])):
            note = "ignored (cover / touchpad)"
        else:
            note = ""
        print(
            f"{name[:42]:<42} {kind:<10} {str(dev['enabled']):<5} "
            f"{str(dev['orientation']):<4} {note}"
        )
    return 0


def remove_duplicate_autostart() -> None:
    auto_dir = Path.home() / ".config" / "autostart"
    for name in OLD_DESKTOPS:
        path = auto_dir / name
        if path.exists():
            path.unlink()
            logging.info("removed duplicate autostart %s", path)


def install_self() -> Path:
    src = Path(__file__).resolve()
    dest_dir = Path.home() / ".local" / "bin"
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / "tiltback-w620"
    if src != dest:
        shutil.copy2(src, dest)
        dest.chmod(0o755)
    follow = dest_dir / "tiltback-follow"
    follow.write_text("#!/bin/sh\nexec \"$HOME/.local/bin/tiltback-w620\" --follow \"$@\"\n")
    follow.chmod(0o755)

    unit_dir = Path.home() / ".config" / "systemd" / "user"
    unit_dir.mkdir(parents=True, exist_ok=True)
    (unit_dir / SERVICE_NAME).write_text(
        "\n".join(
            [
                "[Unit]",
                "Description=TiltBack W620 follow-output residual",
                "After=graphical-session.target",
                "PartOf=graphical-session.target",
                "",
                "[Service]",
                "Type=simple",
                "ExecStart=%h/.local/bin/tiltback-w620 --follow",
                "Restart=on-failure",
                "RestartSec=2",
                "",
                "[Install]",
                "WantedBy=graphical-session.target",
                "",
            ]
        )
    )
    remove_duplicate_autostart()
    logging.info("installed %s and %s (systemd only)", dest, SERVICE_NAME)
    return dest


def enable_service() -> None:
    run(["systemctl", "--user", "daemon-reload"])
    run(["systemctl", "--user", "disable", "--now", OLD_SERVICE])
    remove_duplicate_autostart()
    proc = run(["systemctl", "--user", "enable", SERVICE_NAME])
    if proc.returncode != 0:
        logging.warning("systemctl enable: %s", proc.stderr.strip())
    # Drop leftover autostart copies before the new unit starts.
    run(["pkill", "-f", "/.local/bin/tiltback-w620 --follow"])
    run(["pkill", "-f", "/.local/bin/tiltback-follow"])
    time.sleep(0.2)
    proc = run(["systemctl", "--user", "restart", SERVICE_NAME])
    if proc.returncode != 0:
        logging.warning("systemctl restart: %s", proc.stderr.strip())


def setup_logging(verbose: bool, daemon: bool) -> None:
    handlers: list[logging.Handler] = [logging.StreamHandler(sys.stderr)]
    if daemon:
        for path in (
            Path("/tmp/tiltback-follow.log"),
            Path.home() / ".local" / "share" / "tiltback" / "follow.log",
        ):
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                handlers.append(logging.FileHandler(path))
                break
            except OSError:
                continue
    logging.basicConfig(
        level=logging.DEBUG if verbose else logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=handlers,
    )


def daemon(safety_interval: float) -> int:
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import Gio, GLib

    DBusGMainLoop(set_as_default=True)
    kwin = KWinBus()
    kwin.refresh_targets()
    apply_residual(kwin, "startup")

    pending: list[int] = []

    def stamp(reason: str) -> bool:
        apply_residual(kwin, reason)
        return True

    def schedule(reason: str) -> None:
        def fire() -> bool:
            pending.clear()
            stamp(reason)
            return False

        for src in pending:
            GLib.source_remove(src)
        pending.clear()
        pending.append(GLib.timeout_add(120, fire))

    def on_props(_interface, _changed, _invalidated, path=None) -> None:
        if not str(path or "").startswith(PREFIX + "/"):
            return
        schedule("kwin property")

    def on_device_added(_sysname) -> None:
        kwin.refresh_targets()
        schedule("device added")

    def on_device_removed(_sysname) -> None:
        kwin.refresh_targets()

    kwin.bus.add_signal_receiver(
        on_props,
        signal_name="PropertiesChanged",
        dbus_interface=PROPS_IFACE,
        path_keyword="path",
    )
    kwin.bus.add_signal_receiver(
        on_device_added,
        signal_name="deviceAdded",
        dbus_interface=MGR_IFACE,
    )
    kwin.bus.add_signal_receiver(
        on_device_removed,
        signal_name="deviceRemoved",
        dbus_interface=MGR_IFACE,
    )

    # Watch the directory, not the file: KWin replaces the inode (atomic write).
    # A watch on kwinoutputconfig.json itself goes silent after the first save.
    monitors = []
    for directory in (
        Path.home() / ".config",
        Path.home() / ".local" / "share" / "kscreen",
    ):
        if not directory.is_dir():
            continue

        def on_dir(_mon, gfile, _other, _event, dest=directory) -> None:
            name = Path(gfile.get_path() or "").name
            if dest.name == "kscreen" or name.startswith("kwinoutputconfig"):
                schedule("output config")
                # KWin often zeros R after the file hits disk. Second stamp wins.
                GLib.timeout_add(400, lambda: (stamp("output config delayed"), False)[1])

        mon = Gio.File.new_for_path(str(directory)).monitor_directory(
            Gio.FileMonitorFlags.WATCH_MOVES, None
        )
        mon.connect("changed", on_dir)
        monitors.append(mon)

    # Signals and file watches miss KWin's in-memory wipe (no notify, or
    # kwinoutputconfig.json cannot be written on a read-only root). Two
    # in-process Gets on the cached digitizer paths are cheap and catch it
    # on the next tick.
    GLib.timeout_add_seconds(2, lambda: (stamp("startup-retry"), False)[1])
    if safety_interval > 0:
        GLib.timeout_add(
            int(safety_interval * 1000),
            lambda: stamp("tick"),
        )

    logging.info(
        "follow-output idle (D-Bus + dir watch + %.2fs Get tick), residual always %s",
        safety_interval,
        R_HOME,
    )
    loop = GLib.MainLoop()
    try:
        loop.run()
    finally:
        for mon in monitors:
            mon.cancel()
    return 0


def cmd_apply() -> int:
    if not apply_home_display():
        return 1
    time.sleep(0.6)
    kwin = KWinBus()
    kwin.refresh_targets()
    apply_residual(kwin, "apply")
    rotation = current_rotation()
    if rotation is None:
        return 1
    print(f"output={rotation_name(rotation)} ({rotation}) residual={R_HOME}")
    return 0


def cmd_install_and_apply() -> int:
    install_self()
    rc = cmd_apply()
    enable_service()
    print()
    print_status()
    return rc


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--install", action="store_true", help="copy script and systemd unit")
    parser.add_argument("--apply", action="store_true", help="set display left + residual 8")
    parser.add_argument("--once", action="store_true", help="re-stamp residual only")
    parser.add_argument("--follow", action="store_true", help="run the follow daemon")
    parser.add_argument("--status", action="store_true", help="print layer and cover state")
    parser.add_argument(
        "--interval",
        type=float,
        default=0.4,
        help="in-process orientation check seconds (two D-Bus Gets, no kscreen-doctor; 0 disables)",
    )
    parser.add_argument("-v", "--verbose", action="store_true")
    args = parser.parse_args()

    setup_logging(args.verbose, daemon=args.follow)

    if args.status:
        return print_status()
    if args.follow:
        return daemon(args.interval)
    if args.once:
        kwin = KWinBus()
        kwin.refresh_targets()
        apply_residual(kwin, "once")
        rotation = current_rotation()
        if rotation is None:
            return 1
        print(f"output={rotation_name(rotation)} ({rotation}) residual={R_HOME}")
        return 0
    if args.install and not args.apply:
        install_self()
        enable_service()
        return 0
    if args.apply and not args.install:
        return cmd_apply()
    return cmd_install_and_apply()


if __name__ == "__main__":
    sys.exit(main())
